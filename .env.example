# Copy to .env (gitignored). Never commit real values.

# Required. Read by the Next server at runtime for every model call.
OPENAI_API_KEY=

# Optional. The deployed Modal endpoint from `modal deploy modal/image_to_3d.py`.
# Absent: every product renders as a colour proxy instead of a generated model.
MODAL_IMAGE_TO_3D_URL=

# Optional. 1 loads Chrome's WebMCP polyfill for browsers without document.modelContext.
# The Playwright suites pass ?webmcp=polyfill in the URL instead.
NEXT_PUBLIC_WEBMCP_POLYFILL=
